  "distractor_rules": {
    "roots": [
      "The three bin labels are fixed as sentence, fragment, run-on. Never change the words or the order.",
      "Every stem is clearly one kind only. A reader must not be able to defend two labels.",
      "Keep the pool near even across the three kinds.",
      "A sentence has one who or what and one action and tells one full idea. End it with a period.",
      "A fragment never has both a subject and a finished predicate that stand alone. Use a noun group, a time or place phrase, or a because or when group.",
      "A run-on is two full ideas smashed with no period and no joining word. Do not use and, but, or a comma to join them.",
      "Use only roots wordlist words plus allowed extras and <NAME>. Prefer listed past forms such as ran, sat, ate, went, baked, barked.",
      "Kid world only: school, home, food, pets, play, family, weather. No brands and no real names.",
      "Tier 3 near misses: a full sentence that adds after or when, a because group that has a who and an action, or two short clauses that look like one busy line."
    ]
  },
  "banned_patterns": [
    "ixl",
    "smartscore",
    "challenge zone",
    "tap ?tap",
    "duolingo",
    "lexia",
    "quill",
    "noredink",
    "seedream",
    "\\bbelt\\b",
    "kindergarten",
    "\\bai\\b",
    "https?://",
    "@",
    "\\bpunctuation\\b",
    "\\bperiod\\b",
    "\\bcomma\\b",
    "\\bsubject\\b",
    "\\bpredicate\\b"
  ],
  "tier_rules": {
    "1": "Short stems of four to six words. Sentences are one clear who plus action. Fragments are a noun group with no verb. Run-ons smash two tiny sentences with no mark.",
    "2": "Grade-level stems of five to seven words. Use two-syllable kid words. Fragments include after or at phrases. Run-ons use two kid actions. Sentences may use irregular past.",
    "3": "Near misses up to ten words. Complete sentences add after or when. Fragments start with because or when but still have a who and an action. Run-ons are two short clauses that look like one line."
  },
  "miss_explain": {
    "sentence": {
      "en": "A sentence tells one full idea. It has a who or what and an action.",
