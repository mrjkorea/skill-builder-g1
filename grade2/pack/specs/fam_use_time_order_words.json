      "ko": "Before는 다음 일보다 먼저라는 뜻입니다."
    },
    "after_later": {
      "en": "After means it happens later than the thing before it.",
      "ko": "After는 앞의 일보다 나중이라는 뜻입니다."
    },
    "later_future": {
      "en": "Later means a time after now.",
      "ko": "Later는 지금보다 뒤의 때를 말합니다."
    },
    "yesterday_past": {
