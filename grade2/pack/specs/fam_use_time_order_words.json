  "tier_rules": {
    "1": "Short stems of four to eight words. The gap is first, then, or last. Distractors are because, if, but, or and.",
    "2": "Stems of five to ten words. Use before, after, or next. Add one wrong time-order word plus linking-word distractors.",
    "3": "Near-miss time words that almost fit. Two-syllable kid words are fine. <NAME> is allowed. Wrong choices fail the slot or tense."
  },
  "miss_explain": {
    "first_start": {
      "en": "First goes at the start of the steps.",
      "ko": "First는 순서의 맨 앞에 옵니다."
    },
