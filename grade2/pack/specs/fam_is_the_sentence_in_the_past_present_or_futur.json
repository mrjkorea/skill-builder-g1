  ],
  "tier_rules": {
    "1": "Short stems of four to six words with a clear verb form. Add a picture lemma when the stem has a concrete noun.",
    "2": "Grade-level stems of five to seven words. Mix irregular past, present progressive, and will plus a base verb.",
    "3": "Near misses and longer stems. Past with yesterday plus an irregular verb. Future with will plus a base verb that looks present."
  },
  "miss_explain": {
    "past": {
      "en": "This already happened. Words like ate, went, or yesterday show the past.",
      "ko": "이미 일어난 일이에요. ate, went, yesterday 같은 말이 과거를 보여 줍니다."
    },
    "present": {
      "en": "This is happening now. Words like is, are, or purrs show the present.",
      "ko": "지금 일어나고 있어요. is, are, purrs 같은 말이 현재를 보여 줍니다."
    },
    "future": {
      "en": "This will happen later. The word will shows the future.",
      "ko": "나중에 일어날 일이에요. will이 미래를 보여 줍니다."
    }
  },
