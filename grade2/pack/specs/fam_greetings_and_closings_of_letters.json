  "distractor_rules": {
    "roots": [
      "Keep all four choices as variants of the same greeting or the same closing. Never mix the two letter parts in one item.",
      "The correct choice has a capital first word, a capital name when a name is used, lowercase on any other word, and a comma at the end.",
      "Wrong choices change only capitals or the comma. Do not add extra words or change Mom, Dad, Grandma, Grandpa, or <NAME>.",
      "Tier 1: make three choices fully lowercase or missing the comma in an obvious way.",
      "Tier 2: drop the first-word capital or the comma, or lowercase the name.",
      "Tier 3: add a wrong capital on the second word of a two-word closing, or lowercase the family name after Dear, Hi, or From.",
      "Never use a real given name. Use <NAME> or Mom, Dad, Grandma, Grandpa."
    ]
  },
