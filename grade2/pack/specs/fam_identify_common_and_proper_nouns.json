  "distractor_rules": {
    "roots": [
      "The two bin labels stay common noun then proper noun. Never change the words or the order.",
      "The last word of every stem is the only noun and the word to sort. Other words must be articles, pronouns, verbs, adjectives, or prepositions.",
      "Write common nouns in lowercase and proper nouns with a capital letter. Use <NAME> for any person name.",
      "Keep about half the pool common and half proper. One tap. One right bin.",
      "Never use mom, dad, grandma, grandpa, sun, moon, or earth. Those can read two ways.",
      "Stay in the kid world of school, home, food, pets, play, family, and weather. No brands.",
      "For tier 3 use job titles as common nouns, <NAME>, or two-word place names from the word list such as New York."
    ]
  },
