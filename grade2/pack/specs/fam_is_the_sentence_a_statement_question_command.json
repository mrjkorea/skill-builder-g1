  "distractor_rules": {
    "roots": [
      "The four labels stay statement, question, command, exclamation in that order. Never rename or reorder them.",
      "Every stem is one complete sentence with only one reading. Do not write a stem that could be two kinds.",
      "Keep the pool near even across the four kinds.",
      "Statements end with a period and tell. Questions end with a question mark and ask. Commands tell someone to act and start with a verb. Exclamations show strong feeling and end with an exclamation mark.",
      "Never write a command that ends with an exclamation mark. Never write an exclamation that asks.",
      "For tier 3, use statements that hold what, where, or how inside them, and exclamations that begin with what or how."
    ]
  },
  "banned_patterns": [
    "ixl",
    "smartscore",
    "challenge zone",
    "tap ?tap",
    "duolingo",
    "lexia",
    "quill",
    "noredink",
