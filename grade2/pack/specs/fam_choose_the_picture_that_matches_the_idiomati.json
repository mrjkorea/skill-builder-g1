    "\\bin the picture\\b",
    "\\blook at the\\b",
    "\\bdrawing of\\b",
    "\\bfigurative\\b",
    "\\bliterally\\b",
    "\\bidiomatic\\b",
    "\\bexpression\\b",
    "\\bidiom\\b",
    "/[æəθðʃʒŋɪʊɑɔ]",
    "\\.mp3"
  ],
  "tier_rules": {
    "1": "Short two-to-four-word idioms. Meaning picture is obvious. Distractors are unrelated kid-world pictures.",
    "2": "Grade-level idioms, including a short <NAME> frame. One distractor is a literal word from the stem.",
    "3": "Near-miss items. Two distractors are literal pictures of words inside the idiom, plus one opposite or close meaning."
  },
  "miss_explain": {
    "idiom_sick": {
      "en": "These words mean someone feels sick, not that the sky looks bad.",
      "ko": "이 말은 날씨가 나쁘다는 뜻이 아니라 몸이 아프다는 뜻입니다."
    },
    "idiom_sleep": {
      "en": "These words mean it is time to sleep, not hay on a farm.",
      "ko": "이 말은 건초가 아니라 잘 시간이라는 뜻입니다."
    },
    "idiom_help": {
      "en": "Give a hand means help someone, not a picture of a hand.",
      "ko": "Give a hand는 손이 아니라 도와준다는 뜻입니다."
    },
    "idiom_talk": {
      "en": "These words mean tell a secret, not food or a pet.",
      "ko": "이 말은 음식이나 동물이 아니라 비밀을 말한다는 뜻입니다."
    },
    "idiom_happy": {
      "en": "These words mean very happy, not the moon or a cloud.",
      "ko": "이 말은 달이나 구름이 아니라 아주 기쁘다는 뜻입니다."
    },
    "idiom_play": {
      "en": "Have a ball means have fun, not a toy ball.",
      "ko": "Have a ball은 공이 아니라 즐겁게 논다는 뜻입니다."
    },
    "idiom_quiet": {
      "en": "Zip your lip means be quiet, not a zipper or a lip.",
      "ko": "Zip your lip은 지퍼나 입이 아니라 조용히 하라는 뜻입니다."
    },
    "idiom_wait": {
      "en": "Hold your horses means wait, not a picture of a horse.",
      "ko": "Hold your horses는 말이 아니라 기다리라는 뜻입니다."
    },
    "idiom_rain": {
      "en": "These words mean heavy rain, not cats or dogs.",
      "ko": "이 말은 고양이나 개가 아니라 비가 많이 온다는 뜻입니다."
    },
    "idiom_read": {
      "en": "Hit the books means read or study, not hit something.",
      "ko": "Hit the books는 때리라는 뜻이 아니라 읽거나 공부하라는 뜻입니다."
    },
    "idiom_easy": {
      "en": "These words mean the work is easy, not a snack.",
      "ko": "이 말은 간식이 아니라 일이 쉽다는 뜻입니다."
    },
    "idiom_eat": {
      "en": "These words mean eat a lot, not an animal.",
      "ko": "이 말은 동물이 아니라 많이 먹는다는 뜻입니다."
    },
    "idiom_cheer": {
      "en": "Break a leg means good luck, not a hurt leg.",
      "ko": "Break a leg은 다친 다리가 아니라 잘하라는 뜻입니다."
    }
  },
