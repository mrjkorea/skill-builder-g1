  "distractor_rules": {
    "roots": [
      "Stem is the idiom, or a short <NAME> frame plus the idiom. Never add picture, means, idiom, or expression to the stem.",
      "Choices are four picturable lemmas, not sentences and not picture descriptions.",
      "Exactly one choice shows the figurative meaning. Never pick the literal scene of the words.",
      "Tier 1 uses far-away kid-world distractors. Tier 2 adds one literal word from the stem. Tier 3 uses two literal stem words as near misses.",
      "Keep meaning lemmas concrete: sick, sleep, rain, happy, help, play, talk, wait, quiet, read, eat, cheer, sad, smile.",
      "Kid world only: school, home, food, pets, play, family, weather. No brands and no real names.",
      "One tap and one right answer. Do not write audio file names."
    ]
  },
  "banned_patterns": [
    "ixl",
    "smartscore",
    "challenge zone",
    "tap ?tap",
    "duolingo",
    "lexia",
    "quill",
    "noredink",
    "seedream",
    "\\bbelt\\b",
    "kindergarten",
