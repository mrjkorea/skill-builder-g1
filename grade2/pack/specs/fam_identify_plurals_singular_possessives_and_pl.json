  "miss_explain": {
    "plural": {
      "en": "This noun names more than one. It does not show who owns something.",
      "ko": "이 명사는 둘 이상을 가리킵니다. 누구의 것인지 나타내지 않습니다."
    },
    "singular_possessive": {
      "en": "A singular possessive shows one owner. Add 's after that one noun.",
      "ko": "단수 소유격은 주인이 한 명일 때 씁니다. 그 명사 뒤에 's를 붙입니다."
    },
    "plural_possessive": {
      "en": "A plural possessive shows more than one owner. Put the mark after the s.",
      "ko": "복수 소유격은 주인이 둘 이상일 때 씁니다. s 뒤에 기호를 붙입니다."
    },
    "irregular_plural": {
      "en": "Mice and men name more than one. They are plurals, not possessives.",
      "ko": "mice와 men은 둘 이상을 가리킵니다. 소유격이 아니라 복수입니다."
    },
    "irregular_pl_poss": {
      "en": "Children's shows that more than one child owns something.",
      "ko": "children's는 여러 아이가 무언가를 가지고 있음을 나타냅니다."
    }
  },
