  "tier_rules": {
    "1": "Short clues of three to five words for familiar two-syllable words. Wrong spellings are obvious: a missing vowel, scrambled letters, or extra repeated letters.",
    "2": "Clues of four to seven words. Wrong spellings double the consonant after the open vowel, or use a vowel team in place of one vowel letter.",
    "3": "Longer clues up to ten words, and a name token when it fits. Wrong spellings on two-syllable or three-syllable words change one letter, usually the consonant that would close the open syllable."
  },
  "miss_explain": {
    "open_long": {
      "en": "An open syllable ends in a vowel. That vowel says its name. Spell it with one vowel letter.",
      "ko": "열린 음절은 모음으로 끝납니다. 그 모음은 자기 이름을 말합니다. 모음 글자는 하나만 쓰세요."
    },
    "no_double": {
      "en": "Do not double the consonant after the vowel. A double consonant closes the syllable.",
      "ko": "모음 다음 자음을 겹쳐 쓰지 마세요. 자음을 겹치면 음절이 닫히고 모음이 짧아집니다."
    },
    "keep_vowel": {
      "en": "Keep the vowel at the end of the open syllable. Do not drop it or add an extra vowel.",
      "ko": "열린 음절 끝의 모음을 지키세요. 모음을 빼거나 여분의 모음을 넣지 마세요."
    }
