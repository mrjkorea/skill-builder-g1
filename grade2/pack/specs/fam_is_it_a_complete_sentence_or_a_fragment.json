  "distractor_rules": {
    "roots": [
      "The two bin labels are fixed. Never change them and never change their order.",
      "Every stem is one kid-world line to sort. Never ask about pictures, marks, or grammar words.",
      "Keep the pool near half complete sentences and half fragments.",
      "Complete sentences must have a who or what and a clear action or being word. Statements, questions, and short commands all count.",
      "Fragments are a noun group with no action, an action with no who, a time or place piece, or a because/when/if/after clause that is not finished.",
      "No stem may be read two ways. Do not use run-ons. Do not use real names.",
      "Tier 3 fragments still have a who and an action but start with because, when, if, or after. Tier 3 completes may use <NAME>, irregular past, or a question form."
    ]
  },
  "banned_patterns": [
    "ixl",
    "smartscore",
    "challenge zone",
    "tap ?tap",
    "duolingo",
    "lexia",
    "quill",
    "noredink",
    "seedream",
    "\\bbelt\\b",
    "kindergarten",
    "\\bai\\b",
    "https?://",
    "@",
