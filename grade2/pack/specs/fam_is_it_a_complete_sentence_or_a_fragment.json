    "the picture shows",
    "which of",
    "choose the",
    "\\bdavid\\b",
    "\\bjohn\\b",
    "\\bpredicate\\b",
    "\\bpunctuation\\b",
    "\\brun-on\\b"
  ],
  "tier_rules": {
    "1": "Short stems of three to five words. Completes have a clear who and a clear action. Fragments are a noun group with no action.",
    "2": "Grade-level stems of five to seven words. Mix question-form completes with after/before pieces and -ing fragments that name no who.",
    "3": "Near misses up to ten words. Unfinished because/when/if clauses that already have a who and an action, and longer completes with <NAME> or irregular past."
  },
  "miss_explain": {
    "complete": {
      "en": "A complete sentence names who or what and tells what happens. It is a whole thought.",
      "ko": "완전한 문장은 누가 무엇을 하는지 말합니다. 생각이 끝까지 이어집니다."
    },
    "missing_verb": {
      "en": "This names someone or something but does not tell what happens. It is a fragment.",
      "ko": "누가 있는지는 말하지만 무엇을 하는지는 없습니다. 문장 조각입니다."
    },
    "missing_subject": {
      "en": "This tells an action but not who does it. It is a fragment.",
      "ko": "동작만 있고 누가 하는지는 없습니다. 문장 조각입니다."
    },
    "fragment": {
      "en": "This is only a time or place piece. It is not a whole thought.",
      "ko": "때나 장소만 있어서 생각이 끝나지 않습니다. 문장 조각입니다."
    },
    "unfinished": {
      "en": "Words like when or because leave the thought unfinished. It is a fragment.",
      "ko": "when이나 because로 시작하면 생각이 끝나지 않습니다. 문장 조각입니다."
    }
  },
