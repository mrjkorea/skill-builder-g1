  "distractor_rules": {
    "roots": [
      "Keep one correct short form. Never write two acceptable short forms in the same choice set.",
      "Use only other month short forms as wrong taps. Do not invent spellings, numbers, or days of the week.",
      "Tier 1 wrong taps come from far months, not the same season.",
      "Tier 2 wrong taps come from nearby months in the same season.",
      "Tier 3 wrong taps are look-alikes: Jan. Jun. Jul., Mar. May, Apr. Aug., or Sept. Dec.",
      "May, June, and July stay full words. Jun. and Jul. are always wrong.",
      "September is only Sept. Never offer Sep. as a choice.",
      "Do not move the period or drop it on Jan. Feb. Mar. Apr. Aug. Sept. Oct. Nov. Dec."
    ]
  },
