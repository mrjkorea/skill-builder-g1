  "distractor_rules": {
    "roots": [
      "Offer four unique whole words and keep the correct compound in a mixed position across the pool, not only first.",
      "One leftover part of the target compound must appear as a distractor on every item.",
      "Never write a second choice that also fits the stem pair or the stem idea.",
      "Wrong compounds must be real closed compounds from the extra list or wordlist, never invented blends.",
      "Keep every stem and choice in the kid world of school, home, food, pets, play, family, or weather.",
      "Tier 3 distractors stay close: two compounds that share a part or topic with the answer, plus one leftover part."
    ]
  },
