  "tier_rules": {
    "1": "Familiar words with a doubled letter before le, such as apple, little, and bubble. Most wrong cuts are easy to see, including the last letter pulled off alone.",
    "2": "Common words with one letter before le, such as table, turtle, candle, and circle. One wrong cut leaves le without that letter, as in tab-le.",
    "3": "Near-miss cuts one letter away on trickier words. Right cuts include ea-gle, ti-tle, peo-ple, and cas-tle. The close wrong cuts are eag-le, tit-le, peop-le, and cast-le."
  },
  "miss_explain": {
    "double_cle": {
      "en": "The same letter is written twice before le. Split between those two letters.",
      "ko": "le 앞에 같은 글자가 두 번 있어요. 그 두 글자 사이를 나누세요."
    },
    "single_cle": {
      "en": "The letter right before le starts the last part. Keep l and e together.",
      "ko": "le 바로 앞의 글자가 마지막 부분을 시작해요. l과 e는 함께 두세요."
    }
  },
