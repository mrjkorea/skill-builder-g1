  "tier_rules": {
    "1": "Stems of two to five words. Same-person or different-person is obvious. Twin distractor plus wrong-case words. Picture the actor or food when a concrete noun is present.",
    "2": "Stems of four to seven words with two-syllable nouns such as puppy or breakfast. Use for-frames or saw-frames. Twin distractor plus wrong person or number.",
    "3": "Near-miss twins such as her and herself or us and ourselves. Longer fronted stems. One NAME helper frame. No second legal reading."
  },
  "miss_explain": {
    "need_reflexive": {
      "en": "Use a -self word when the same person does the action to that same person.",
      "ko": "같은 사람이 자기 자신에게 하는 일에는 -self가 붙은 말을 씁니다."
    },
    "need_personal": {
      "en": "Use me, him, her, us, or them when the action goes to someone else.",
      "ko": "다른 사람에게 하는 일에는 me, him, her, us, them을 씁니다."
    },
    "wrong_person": {
      "en": "Match who the word talks about. He pairs with himself. She pairs with herself.",
      "ko": "말이 가리키는 사람과 짝을 맞추세요. he는 himself, she는 herself와 씁니다."
    }
