  "distractor_rules": {
    "roots": [
      "Every choice is one closed compound in lowercase with no spaces or hyphens.",
      "Exactly one choice is the true join of the two media lemmas in left-to-right order.",
      "Never write either picture lemma in the stem, and never describe what a picture shows.",
      "Never offer a two-word phrase, a definition, or a single picture lemma as a choice.",
      "Tier 1 wrong choices share no part with the answer and come from home, food, pets, or play.",
      "Tier 2 wrong choices share the first part or the last part, but not both.",
      "Tier 3 uses near misses: swapped order, the same first part, or the same last part.",
      "Both media lemmas must be concrete picturable words from kid life. No brands."
    ]
  },
  "banned_patterns": [
    "ixl",
    "smartscore",
    "challenge zone",
    "tap ?tap",
    "duolingo",
    "lexia",
    "quill",
    "noredink",
    "seedream",
    "\\bbelt\\b",
    "kindergarten",
    "\\bai\\b",
    "https?://",
    "@",
    "\\bfirst picture\\b",
    "\\bsecond picture\\b",
    "in the picture",
    "looks like",
    "this picture shows",
    "\\/[^/\\s]+\\/"
  ],
  "tier_rules": {
    "1": "Short stem of four to six words. Two clear picture lemmas. Wrong choices are unrelated compounds from home, food, pets, or play.",
    "2": "Grade-level stem. Wrong choices share the first part or the last part with the answer, but not both parts.",
    "3": "Near-miss compounds: swapped order, same first word, or same last word. Stem may use <NAME>."
  },
  "miss_explain": {
    "join_parts": {
      "en": "Put both picture words together to make one new word.",
      "ko": "두 그림의 낱말을 붙여 하나의 새 낱말을 만듭니다."
    },
    "first_then_second": {
      "en": "Say the first picture, then the second. That makes the compound word.",
      "ko": "첫 그림 낱말을 말하고, 다음 그림 낱말을 이어서 말하세요."
    },
    "not_just_one": {
      "en": "Use both pictures. A word that uses only one picture is not right.",
      "ko": "두 그림을 모두 써야 합니다. 한쪽만 쓴 낱말은 오답입니다."
    },
    "not_near": {
      "en": "That word is close, but it does not join these two pictures.",
      "ko": "비슷한 말이지만 이 두 그림을 이은 낱말은 아닙니다."
    },
    "not_swapped": {
      "en": "Keep the picture order. Do not switch the two words around.",
      "ko": "그림 순서대로 붙이세요. 두 낱말의 자리를 바꾸면 안 됩니다."
    }
  },
