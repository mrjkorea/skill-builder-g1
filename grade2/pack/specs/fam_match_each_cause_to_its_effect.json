    "\\bthe effect\\b",
    "\\bwhich is the cause\\b",
    "\\bwhich is the effect\\b",
    "\\bwhat happened first\\b"
  ],
  "tier_rules": {
    "1": "Short cause stems of four to six words. The effect is obvious. Wrong choices are unrelated kid-world events.",
    "2": "Grade 2 stems of five to eight words, often two-syllable. Wrong choices share a noun with the stem but are not the effect.",
    "3": "Near-miss pairs. Wrong choices restate the cause, reverse cause and effect, or give the opposite outcome."
  },
  "miss_explain": {
    "match_effect": {
      "en": "The effect is what happens because of the cause. Tap that.",
      "ko": "결과는 원인 때문에 일어나는 일입니다. 그것을 누르세요."
    },
    "not_related": {
      "en": "That may be true, but it does not happen because of this cause.",
      "ko": "그럴 수도 있지만, 이 원인 때문에 일어난 일이 아닙니다."
    },
    "restated_cause": {
      "en": "That tells why it started. It is a cause, not the effect.",
      "ko": "그것은 왜 시작되었는지를 말합니다. 원인이고 결과가 아닙니다."
    },
    "opposite_event": {
      "en": "That is the opposite of what this cause would make happen.",
      "ko": "그것은 이 원인이 일어나게 할 일과 반대입니다."
    }
