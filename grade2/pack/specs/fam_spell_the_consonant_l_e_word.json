  "tier_rules": {
    "1": "Short stems and familiar words such as apple, table, and turtle. Use a picture lemma. Wrong spellings change the vowel or drop a chunk so the miss is obvious.",
    "2": "Grade-level words such as eagle, circle, and people. Wrong spellings drop the silent e, write el instead of le, or change one vowel letter.",
    "3": "Near misses only. Short vowels keep a double consonant, as in little. Long vowels keep one consonant, as in title. Stems are longer clues and never show the spelling."
  },
  "miss_explain": {
    "double_le": {
      "en": "A short vowel needs two consonants before l e.",
      "ko": "단모음이면 l e 앞 자음을 두 번 써요."
    },
    "single_le": {
      "en": "A long vowel or vowel team needs one consonant before l e.",
      "ko": "장모음이나 모음 조합이면 l e 앞 자음은 한 번만 써요."
    },
    "keep_le": {
      "en": "This word ends with consonant l e. The e is silent. Do not drop it.",
      "ko": "이 단어는 자음 l e로 끝나요. e는 소리가 없어요. 빼지 마세요."
    },
    "le_order": {
      "en": "Write l then e at the end. Do not swap them.",
      "ko": "끝에 l 다음에 e를 써요. 자리를 바꾸지 마세요."
    }
