  "tier_rules": {
    "1": "Short stems of four to six words. One obvious color or size adjective sits right before the noun. Distractors are the noun, a verb, and a place or person word. Add a noun picture.",
    "2": "Grade-level stems of five to seven words. Use two-syllable adjectives, a second noun, or a describing word after is or are. Distractors stay on grade.",
    "3": "Near misses. The stem holds both one adjective and an -ly adverb. The adverb is a wrong choice. Keep only one describing adjective."
  },
  "miss_explain": {
    "adj_before": {
      "en": "The describing word sits by the noun. It tells what the noun is like.",
      "ko": "꾸며 주는 말은 명사 옆에 있어요. 명사가 어떤지 알려 줍니다."
    },
    "adj_linking": {
      "en": "After is or are, the describing word still tells about the noun.",
      "ko": "is나 are 뒤에 있어도 그 말은 명사를 꾸며 줍니다."
    },
    "adj_not_adverb": {
      "en": "A word that ends with ly tells how. The describing word tells what kind.",
      "ko": "ly로 끝나는 말은 어떻게인지 말해요. 꾸며 주는 말은 어떤지 말해요."
    },
    "adj_not_noun": {
      "en": "The noun is the person or thing. Tap the word that tells about it.",
      "ko": "명사는 사람이나 사물이에요. 그것을 알려 주는 말을 누르세요."
    }
  },
