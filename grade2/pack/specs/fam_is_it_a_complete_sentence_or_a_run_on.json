    "\\bjohn\\b",
    "\\?"
  ],
  "tier_rules": {
    "1": "Short stems of four to six words. Complete sentences have one subject, one verb, and a period. Run-ons jam two short subject-verb pairs with no comma and no linking word.",
    "2": "Grade-level stems of five to eight words. Use two-syllable kid words. Run-ons may start the second thought with we or they. Add a lemma picture for the first noun.",
    "3": "Near misses up to ten words. Complete sentences join two thoughts with and, but, or so. Run-ons are longer comma splices that look like one story."
  },
  "miss_explain": {
    "complete": {
      "en": "A complete sentence tells one full thought. It has a who or what and what they do.",
      "ko": "완전한 문장은 생각 하나를 끝까지 말합니다. 누가 무엇을 하는지 있습니다."
    },
    "run_on": {
      "en": "A run-on sticks two sentences together. Split them or join them with and.",
      "ko": "이어 붙인 문장은 문장 두 개를 붙여 둡니다. 나누거나 and로 잇습니다."
    },
    "compound_ok": {
      "en": "And can join two thoughts. That is still one complete sentence.",
      "ko": "And는 생각 두 개를 이을 수 있습니다. 그래도 완전한 문장 하나입니다."
    }
  },
