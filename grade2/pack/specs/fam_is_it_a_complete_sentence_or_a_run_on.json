  "distractor_rules": {
    "roots": [
      "The two bin labels stay complete sentence then run-on. Never rename them, add bins, or swap their order.",
      "Every stem is one complete sentence or a run-on of two complete thoughts. Never use a fragment.",
      "Keep the pool near half complete sentences and half run-ons.",
      "A run-on has two subject-verb thoughts with no and, but, or so and no period between them. A comma splice is a run-on.",
      "A complete sentence may join two thoughts with and, but, or so. That is still complete, not a run-on.",
      "Stems use only the roots word list, allowed_extra_words, and <NAME>. No real names.",
      "Stay in kid world: school, home, food, pets, play, family, weather. No brands.",
      "One right bin. Tap only."
    ]
  },
  "banned_patterns": [
    "ixl",
    "smartscore",
    "challenge zone",
    "tap ?tap",
    "duolingo",
    "lexia",
    "quill",
    "noredink",
