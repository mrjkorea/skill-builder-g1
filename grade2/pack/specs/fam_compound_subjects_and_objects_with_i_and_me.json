  ],
  "tier_rules": {
    "1": "Short stems of four to six words. The gap is I or me after and. Subjects do an action; objects get one. Add a picture lemma on a concrete noun.",
    "2": "Grade-level stems of five to seven words. Mix action verbs with to, with, and for. A family word like sister may replace a name.",
    "3": "Near-miss stems up to ten words. Use between, time openers, or verbs like asked. Only one of I or me can pass the alone test."
  },
  "miss_explain": {
    "subject_i": {
      "en": "Use I when you do the action with someone. Try it alone: I walk.",
      "ko": "누군가와 같이 할 때는 I를 씁니다. 혼자 말하면 I walk입니다."
    },
    "object_me": {
      "en": "Use me when the action happens to you. Try it alone: hugged me.",
      "ko": "행동이 나에게 일어나면 me를 씁니다. 혼자 말하면 hugged me입니다."
    },
    "after_prep": {
      "en": "After to, with, for, or between, use me.",
      "ko": "to, with, for, between 뒤에는 me를 씁니다."
    }
  },
