  "distractor_rules": {
    "roots": [
      "Exactly one choice is a true sensory detail about the pictured lemma. Never write two choices that both fit the picture.",
      "Wrong choices must name a different kid-world object, or pair the pictured object with a sense or quality that cannot fit.",
      "Never describe the picture in the stem. The lemma picture names the object. Stems stay short and generic.",
      "Keep all four choices short sensory phrases, same grammar shape when possible.",
      "For tier 3 use near-misses: same sense with the wrong object, or the same object with the opposite or impossible sense.",
      "Kid world only: school, home, food, pets, play, family, weather. No brands and no real names.",
      "One tap and one right answer. Do not reuse the same lemma and answer pair."
    ]
  },
  "banned_patterns": [
    "ixl",
    "smartscore",
    "challenge zone",
    "tap ?tap",
    "duolingo",
    "lexia",
    "quill",
    "noredink",
    "seedream",
    "\\bbelt\\b",
    "kindergarten",
    "\\bai\\b",
