    "@",
    "picture shows",
    "in the picture",
    "you can see",
    "this picture",
    "\\bfive senses\\b",
    "\\/[^/]+\\/"
  ],
  "tier_rules": {
    "1": "Short generic stem of three to five words. Common picture. Correct choice names that object with an obvious sense. Distractors are other objects.",
    "2": "Grade-level stems. Mix smell, taste, and touch. One distractor may use the same object with a poor sense, or another food.",
    "3": "Near-miss distractors: same sense and wrong object, or same object and opposite quality. Two-syllable words are fine."
  },
  "miss_explain": {
