  "distractor_rules": {
    "roots": [
      "Give four unique one-word choices. Exactly one is the closed compound formed by joining the two source words in the stem, in that order.",
      "Never use a plus sign, a hyphenated form, a spaced open compound, IPA, or a picture described in prose.",
      "Both source words in the stem must come from the roots wordlist. The target compound may be on that list or in allowed_extra_words.",
      "Tier 1 distractors are unrelated kid-world words. They are not compounds and they are not either source word.",
      "Tier 2 distractors include each source word alone plus one other real compound.",
      "Tier 3 distractors are three other real compounds that reuse one source word or a close pair.",
      "Keep stems at or under ten words. Use <NAME> only, never a real name. Stay in school, home, food, pets, play, family, or weather. No brands."
    ]
  },
  "banned_patterns": [
    "ixl",
