    "yahoo",
    "ebay"
  ],
  "tier_rules": {
    "1": "Stem is the two source words joined by and, four words or fewer. Add a picture lemma of the target. Distractors are distant unrelated words, not parts and not compounds.",
    "2": "Short stem or a NAME frame up to eight words. Distractors are the two source words alone plus one other real compound.",
    "3": "NAME frame or a slightly longer stem. All three distractors are real compounds that share a part or a close pair with the target."
  },
  "miss_explain": {
