  "tier_rules": {
    "1": "Short stems of four to six words. Wrong apostrophe on a clear plural, or a missing 's for one owner. Picture lemma of that noun.",
    "2": "Grade-level stems of five to seven words. Mix boy's versus boys, two-syllable words, and irregular children's.",
    "3": "Near-miss possessives. Stems name more than one owner. The main trap is dog's versus dogs' or pet's versus pets'."
  },
  "miss_explain": {
    "no_apostrophe_plural": {
      "en": "A plural names more than one. Do not use an apostrophe.",
      "ko": "복수형은 둘 이상을 가리킵니다. 아포스트로피를 쓰지 마세요."
    },
    "one_owner": {
      "en": "One owner needs 's. The thing belongs to one.",
      "ko": "주인이 한 명이면 's를 씁니다. 물건이 한 명의 것입니다."
    },
    "many_owners": {
      "en": "More than one owner needs s'. The things belong to many.",
      "ko": "주인이 여럿이면 s'를 씁니다. 물건이 여러 명의 것입니다."
    },
    "irregular_possessive": {
      "en": "Some nouns change in the plural. Add 's after that plural.",
      "ko": "어떤 명사는 복수가 달라집니다. 그 복수형 뒤에 's를 붙입니다."
    }
  },
