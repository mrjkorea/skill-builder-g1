    "\\/"
  ],
  "tier_rules": {
    "1": "Short part-in-word stems. Common prefix un or suffix ing or ed. The base is a clear one-syllable list word. Add a lemma picture of the whole word.",
    "2": "Grade-level stems. Prefix re or dis, or suffix er or ly on a two-syllable word such as teacher or slowly. Show the base inside the longer word.",
    "3": "Less common or near-miss parts: prefix pre or dis, suffix ful or ness, or a two-syllable base such as happy. Never invent an affix that is not really there."
  },
  "miss_explain": {
    "prefix": {
      "en": "A prefix goes on the front of a base word, like un in unpack.",
      "ko": "접두사는 기본 낱말 앞에 붙어요. unpack의 un처럼요."
    },
    "suffix": {
      "en": "A suffix goes on the end of a base word, like ing in running.",
      "ko": "접미사는 기본 낱말 뒤에 붙어요. running의 ing처럼요."
    },
    "base_word": {
      "en": "A base word is the main word. Other parts can join it.",
      "ko": "기본 낱말은 중심 말이에요. 다른 조각이 붙을 수 있어요."
    }
  },
