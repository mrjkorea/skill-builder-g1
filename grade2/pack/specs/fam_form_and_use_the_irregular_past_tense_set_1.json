  "tier_rules": {
    "1": "Stems of four to six words with yesterday or last night. Distractors are a fake -ed form, a present form, and an -ing form. Add a lemma picture.",
    "2": "Grade-level stems of five to seven words. Mix overregularized -ed with a participle such as gone or given, plus present or -ing.",
    "3": "Near-miss distractors: written or taken beside the true past, or a different irregular past from the same set. Stems may use two-syllable nouns."
  },
  "miss_explain": {
    "not_regular": {
      "en": "This verb does not add -ed. Pick the special past form.",
      "ko": "이 동사는 -ed를 붙이지 않습니다. 특별한 과거형을 고르세요."
    },
    "not_present": {
      "en": "That word is for now. Yesterday needs the past form.",
      "ko": "그 단어는 지금을 나타냅니다. yesterday에는 과거형이 필요합니다."
    },
    "not_ing": {
      "en": "A word that ends in -ing is not the past.",
      "ko": "-ing로 끝나는 단어는 과거형이 아닙니다."
    },
    "not_participle": {
      "en": "Gone, done, and given need have or has. Pick the past that stands alone.",
      "ko": "gone, done, given은 have나 has가 필요합니다. 혼자 쓰는 과거형을 고르세요."
    },
    "wrong_verb": {
      "en": "That past form belongs to a different verb.",
      "ko": "그 과거형은 다른 동사의 과거형입니다."
    },
    "use_past": {
      "en": "A time word like yesterday means the action already happened.",
      "ko": "yesterday 같은 말은 이미 일어난 일을 뜻합니다."
    }
  },
