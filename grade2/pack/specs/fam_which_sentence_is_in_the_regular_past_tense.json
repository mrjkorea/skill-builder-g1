  "miss_explain": {
    "regular_ed": {
      "en": "Regular past tense adds -ed. Baked, cleaned, and packed are regular past.",
      "ko": "규칙 과거시제는 동사에 -ed를 붙입니다. baked, cleaned, packed가 규칙 과거입니다."
    },
    "irregular_past": {
      "en": "Some past verbs change, like sang or saw. They are past, but not regular -ed.",
      "ko": "어떤 과거 동사는 형태가 바뀝니다. sang, saw처럼 -ed가 없는 불규칙 과거입니다."
    },
    "present_now": {
      "en": "That sentence is happening now. Regular past names a finished action with -ed.",
      "ko": "그 문장은 지금 일어나는 일입니다. 규칙 과거는 -ed로 끝난 일을 나타냅니다."
    },
    "future_will": {
      "en": "Will plus a verb is future. Regular past already happened and ends with -ed.",
      "ko": "will과 동사는 미래입니다. 규칙 과거는 이미 일어난 일이며 -ed로 끝납니다."
    },
    "was_were": {
      "en": "Was and were are past, but they do not add -ed. They are not regular past.",
      "ko": "was와 were는 과거이지만 -ed를 붙이지 않습니다. 규칙 과거가 아닙니다."
    },
    "adjective_ed": {
      "en": "Is plus an -ed word can describe something. That is not a regular past action.",
      "ko": "is 다음 -ed 단어는 상태를 말하기도 합니다. 규칙 과거 동작이 아닙니다."
    }
  },
